# Copiar a .env antes de levantar el producto:  cp .env.example .env
# Cambiar las contraseñas si el entorno no es local.

# Base de datos del producto
APP_DB_USER=nova
APP_DB_PASSWORD=nova_password
APP_DB_NAME=novamercado

# Base de datos de metadatos de Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_password
AIRFLOW_DB_NAME=airflow

# Usuario administrador de Airflow (UI y API REST)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password

# Claves internas de Airflow
# Generar una fernet key con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=cambiar_esta_clave

# Puertos del host para las interfaces web (cambiar solo si están ocupados).
# La API siempre usa el puerto 8000 (contrato).
AIRFLOW_HOST_PORT=8080
MLFLOW_HOST_PORT=5000
